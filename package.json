  "type": "module",
  "dependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.169.0"
  },
  "private": true,
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "wrangler": "^4.136.3"
  }
